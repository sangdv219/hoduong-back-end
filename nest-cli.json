{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "config/**/*",
        "outDir": "dist"
      }
    ],
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@models/*": ["src/infrastructure/models/*"],
      "@core/*": ["src/core/*"],
      "@database/*": ["src/database/*"],
      "@redis/*": ["src/redis/*"],
      "@bull/*": ["src/bull/*"],
      "@shared/*": ["src/shared/*"],
      "@audit/*": ["src/audit/*"],
      "@infrastructure/*": ["src/infrastructure/*"]
    }
  }
}